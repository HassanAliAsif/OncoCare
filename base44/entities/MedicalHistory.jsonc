{
  "name": "MedicalHistory",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "title": "Patient ID"
    },
    "patient_name": {
      "type": "string",
      "title": "Patient Name"
    },
    "patient_email": {
      "type": "string",
      "format": "email",
      "title": "Patient Email"
    },
    "condition": {
      "type": "string",
      "title": "Condition / Illness"
    },
    "diagnosed_date": {
      "type": "string",
      "format": "date",
      "title": "Diagnosed Date"
    },
    "severity": {
      "type": "string",
      "enum": [
        "mild",
        "moderate",
        "severe",
        "resolved"
      ],
      "title": "Severity"
    },
    "treatment_received": {
      "type": "string",
      "title": "Treatment Received"
    },
    "is_chronic": {
      "type": "boolean",
      "default": false,
      "title": "Chronic Condition"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "patient_id",
    "condition"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}